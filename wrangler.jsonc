{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9de5119c-eed1-4375-bcd7-3615097cc868","database_name": "dd1" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "f20545dc151644b78f3b740fe259a0da" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
